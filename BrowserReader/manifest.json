{
 "manifest_version":3,"name":"BoardLens Browser Reader","version":"3.5.0",
 "description":"Connect to BoardLens for board reading and on-page coaching on Chess.com and Lichess.",
 "permissions":["storage"],"host_permissions":["http://127.0.0.1:8788/*"],
 "background":{"service_worker":"background.js"},"action":{"default_popup":"popup.html"},
 "content_scripts":[
  {"matches":["https://www.chess.com/*","https://lichess.org/*"],"js":["reader.js"],"world":"MAIN","run_at":"document_idle"},
  {"matches":["https://www.chess.com/*","https://lichess.org/*"],"js":["coach.js","content.js"],"run_at":"document_idle"}
 ]
}
